# Preserve platform-independent text format without rewriting binary evidence.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.css text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pgm binary
*.ppm binary
